{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "charmanita-dev",
	"compatibility_date": "2026-04-21",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "charmanita.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.charmanita.dev",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "GUESTBOOK_DB",
			"database_name": "GUESTBOOK_DB",
			"database_id": "ed055fa6-a337-4b9f-96bc-9c73735a5de1"
		}
	]
}